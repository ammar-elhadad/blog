---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { href } from '../../utils';
import { getAllPosts } from '../../posts';

const posts = await getAllPosts();
const counts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags ?? []) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags" description="Browse posts by tag.">
  <div class="page-head">
    <p class="section-eyebrow">index</p>
    <h1>Tags <span class="kanji">印</span></h1>
    <p>Everything cross-referenced by technique and topic.</p>
  </div>

  {
    tags.length === 0 ? (
      <p class="muted">No tags yet.</p>
    ) : (
      <div class="tags">
        {tags.map(([tag, count]) => (
          <a class="tag" href={href(`/tags/${tag}`)}>
            {tag} <span class="muted">{count}</span>
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>
