---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPosts, pillFor } from '../../posts';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const tags = new Set<string>();
  posts.forEach((p) => (p.data.tags ?? []).forEach((t) => tags.add(t)));

  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => (p.data.tags ?? []).includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <div class="page-head">
    <p class="section-eyebrow">tag</p>
    <h1><span class="kanji">印</span> #{tag}</h1>
    <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged <strong>{tag}</strong>.</p>
  </div>

  <div class="card-grid">
    {
      posts.map((p) => (
        <PostCard
          section={p.section}
          title={p.data.title}
          description={p.data.description}
          url={p.url}
          pubDate={p.data.pubDate}
          tags={p.data.tags}
          pill={pillFor(p)}
        />
      ))
    }
  </div>
</BaseLayout>
